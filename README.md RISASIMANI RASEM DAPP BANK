        if (!userAddress || !provider) return "0.00";
        try {
            const net = NETWORKS[currentChainId];
            const token = net.tokens.find(t => t.symbol === tokenSymbol);
            if (!token) return "0.00";

            if (token.isNative) {
                const rawBal = await readRpc(currentChainId).getBalance(userAddress);
