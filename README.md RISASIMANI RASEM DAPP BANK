            if (pair === ethers.constants.AddressZero) continue;
            const pc = new ethers.Contract(pair, PAIR_ABI, rp);
            const [r, t0] = await Promise.all([pc.getReserves(), pc.token0()]);
            const isStable = q === st.address;
            const qAmt = parseFloat(ethers.utils.formatUnits(t0.toLowerCase() === q.toLowerCase() ? r.r0 : r.r1, isStable ? st.decimals : 18));
            const usd = isStable ? qAmt : (bUsd ? qAmt * bUsd : null);
            return { qSym: isStable ? st.symbol : "WBNB", usd: usd == null ? null : usd * 2 };
        }
        return null;
    }

    // RSM ve ASM için zincirden derlenen gerçek veriler (fiyat, likidite, arz/FDV, son transferler)
    async function hotBulletins() {
        const bsc = NETWORKS["0x38"], rp = readRpc("0x38"), st = stableOf(bsc), bUsd = await bnbUsd();
        const head = await rp.getBlockNumber(), from = head - 2000;
        let mins = 15;
        try { const [hb, fb] = await Promise.all([rp.getBlock(head), rp.getBlock(from)]); mins = Math.max(1, Math.round((hb.timestamp - fb.timestamp) / 60)); } catch (e) {}
        const now = new Date().toLocaleTimeString(locale());
        const out = await Promise.all(bsc.tokens.filter(t => t.logo && t.ok !== false).map(async t => {
            const cards = [], lbl = t.tk || t.symbol;
            const [price, pool, sup, logs] = await Promise.all([
                onchainUsd(bsc, rp, t, st).catch(() => null),
                poolInfo(bsc, rp, t, st, bUsd).catch(() => null),
                new ethers.Contract(t.address, ERC20_ABI, rp).totalSupply().catch(() => null),
                rp.getLogs({ address: t.address, topics: [TRANSFER_TOPIC], fromBlock: from, toBlock: head }).catch(() => null)
            ]);
            const mk = (time, title, url) => cards.push({ hot: true, logo: t.logo, time: lbl + " · " + time, title, url });
            if (price != null) mk(now, nt('price', { p: "$" + fmtPrice(price) }));
            if (pool) mk(now, nt('pool', { l: pool.usd == null ? "n/a" : "$" + fmtBig(pool.usd), q: pool.qSym }));
            else mk(now, nt('nopool'));
            if (sup) { const s = parseFloat(ethers.utils.formatUnits(sup, t.decimals)); mk(now, nt('fdv', { s: fmtBig(s), f: price == null ? "n/a" : "$" + fmtBig(price * s) })); }
            if (logs) {
                const tr = logs.filter(l => l.topics.length === 3).slice(-2).reverse();
                if (!tr.length) mk(now, nt('notx', { m: mins }));
                for (const l of tr) {
                    const blk = await rp.getBlock(l.blockNumber).catch(() => null);
                    const amt = parseFloat(ethers.utils.formatUnits(ethers.BigNumber.from(l.data), t.decimals));
                    mk(blk ? new Date(blk.timestamp * 1000).toLocaleString(locale()) : "#" + l.blockNumber,
                       nt('tx', { a: fmtBig(amt) + " " + lbl, x: shortAddr("0x" + l.topics[1].slice(26)) + " → " + shortAddr("0x" + l.topics[2].slice(26)) }), "https://bscscan.com/tx/" + l.transactionHash);
                }
            }
            return cards;
        }));
        return out.flat();
    }

    async function projectNews() {
        if (!PROJECT_NEWS_URL) return [];
        try {
            const j = await (await fetch(PROJECT_NEWS_URL, { cache: "no-store" })).json();
            return (Array.isArray(j) ? j : []).slice(0, 5).map(n => ({ hot: true, time: String(n.time || ""), title: String(n.title || ""), url: /^https:\/\//i.test(n.url || "") ? n.url : "" }));
        } catch (e) { return []; }
    }

    // Binance haberleri: 1) Binance duyuruları (resmî olmayan bapi, CORS izin verirse) 2) Cointelegraph "binance" etiketi 3) CryptoCompare. İlk çalışan kaynak kullanılır.
    async function binanceNews() {
        if (newsCache.v && Date.now() - newsCache.t < 120000) return newsCache.v;
        const sources = [
            ["Binance Announcements", async () => {
                const all = [];
                for (const cat of [49, 48]) {
                    const j = await (await fetch(`https://www.binance.com/bapi/composite/v1/public/cms/article/list/query?type=1&pageNo=1&pageSize=8&catalogId=${cat}`, { cache: "no-store" })).json();
                    const arts = (j.data && (j.data.articles || (j.data.catalogs || []).flatMap(c => c.articles || []))) || [];
                    arts.forEach(a => all.push({ title: a.title, ts: a.releaseDate || a.publishDate || 0, url: "https://www.binance.com/en/support/announcement/detail/" + a.code }));
                }
                return all;
            }],
            ["Cointelegraph (binance)", async () => {
                const j = await (await fetch("https://api.rss2json.com/v1/api.json?rss_url=" + encodeURIComponent("https://cointelegraph.com/rss/tag/binance"))).json();
                return (j.items || []).map(i => ({ title: i.title, ts: Date.parse(String(i.pubDate).replace(' ', 'T') + 'Z') || 0, url: i.link }));
            }],
            ["CryptoCompare (BNB)", async () => {
                const j = await (await fetch("https://min-api.cryptocompare.com/data/v2/news/?lang=EN&categories=BNB")).json();
                return (j.Data || []).map(i => ({ title: i.title, ts: (i.published_on || 0) * 1000, url: i.url }));
            }]
        ];
        for (const [name, fn] of sources) {
            try {
                const items = (await fn()).filter(i => i.title && /^https:\/\//i.test(i.url)).sort((a, b) => b.ts - a.ts).slice(0, 6);
                if (items.length) { newsCache = { t: Date.now(), v: { items, src: name } }; return newsCache.v; }
            } catch (e) {}
        }
        return { items: [], src: "" };
    }

    function renderNews() {
        const box = document.getElementById('news-list'); if (!box) return;
        box.textContent = '';
        const sec = txt => { const d = document.createElement('div'); d.className = 'news-sec'; d.textContent = txt; box.appendChild(d); };
        const card = (n, to = box) => {
            const c = document.createElement('div'); c.className = 'news-card' + (n.hot ? ' hot' : '');
            const wrap = n.url ? Object.assign(document.createElement('a'), { href: n.url, target: '_blank', rel: 'noopener noreferrer' }) : c;
            const tm = document.createElement('span'); tm.className = 'news-time';
            if (n.logo) { const im = document.createElement('img'); im.src = LOGOS[n.logo]; im.className = 'tick-ico'; tm.appendChild(im); }
            tm.appendChild(document.createTextNode(n.time || ''));
            const ti = document.createElement('span'); ti.className = 'news-title'; ti.textContent = n.title;
            wrap.appendChild(tm); wrap.appendChild(document.createElement('br')); wrap.appendChild(ti);
            if (wrap !== c) c.appendChild(wrap);
            to.appendChild(c);
        };
        if (newsData.hot.length) { sec(nt('secHot')); newsData.hot.forEach(card); }
        if (newsData.proj.length) { sec(nt('secProj')); newsData.proj.forEach(card); }
        const pb = document.getElementById('partner-news') || box;   // Binance haberleri artık Stratejik Partner kutusunda
        if (pb !== box) pb.textContent = '';
        const hd = document.createElement('div'); hd.className = 'news-sec'; hd.textContent = nt('secBin') + (newsData.src ? ' · ' + nt('src') + ': ' + newsData.src : ''); pb.appendChild(hd);
        if (newsData.bin.length) newsData.bin.slice(0, 8).forEach(n => card({ time: n.ts ? new Date(n.ts).toLocaleString(locale()) : '', title: n.title, url: n.url }, pb));
        else card({ time: '—', title: nt('binErr') }, pb);
        document.getElementById('news-stamp').textContent = newsData.stamp ? nt('upd') + ': ' + newsData.stamp.toLocaleTimeString(locale()) : '';
    }

    async function refreshNews() {
        const [hot, proj, bin] = await Promise.all([hotBulletins().catch(() => []), projectNews(), binanceNews().catch(() => ({ items: [], src: "" }))]);
        newsData = { hot, proj, bin: bin.items, src: bin.src, stamp: new Date() };
        renderNews();
    }

