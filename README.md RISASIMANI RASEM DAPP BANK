                    if (Object.keys(m).length) return m;
                } catch (e) {}
            }
        }
        return {};
    }

    // 1 token'in dolar karşılığı: yönlendirici havuzundan canlı (önce doğrudan, sonra yerel token üzerinden)
    async function onchainUsd(net, rp, token, stable) {
        const router = new ethers.Contract(net.routerAddress, ROUTER_ABI, rp);
        const one = ethers.utils.parseUnits("1", token.decimals);
        const ta = token.isNative ? net.wNative : token.address;
        for (const path of (ta.toLowerCase() === net.wNative.toLowerCase() ? [[ta, stable.address]] : [[ta, stable.address], [ta, net.wNative, stable.address]])) {
            try { const a = await router.getAmountsOut(one, path); return parseFloat(ethers.utils.formatUnits(a[a.length - 1], stable.decimals)); } catch (e) {}
        }
        return null;
    }

