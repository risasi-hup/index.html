    async function poolBox(t, q, lic) {
        const bsc = NETWORKS["0x38"], rp = readRpc("0x38"), L = a => a.toLowerCase(), cands = [];
        try {
            const fac = new ethers.Contract(await new ethers.Contract(bsc.routerAddress, ROUTER_ABI, rp).factory(), FACTORY_ABI, rp);
            const a = await fac.getPair(t.address, q.address);
            if (a !== ethers.constants.AddressZero) cands.push({ v: "V2", a });
        } catch (e) {}
        try {
            const f3 = new ethers.Contract(V3_FACTORY, V3F_ABI, rp);
            await Promise.all(V3_FEES.map(async fee => {
                const a = await f3.getPool(t.address, q.address, fee);
                if (a !== ethers.constants.AddressZero) cands.push({ v: "V3 " + (fee / 10000) + "%", a, v3: true });
            }));
        } catch (e) {}
        const qUsd = q.symbol === "WBNB" ? await bnbUsd() : 1, qc = new ethers.Contract(q.address, ERC20_ABI, rp);
        let best = null, usd = null;
        for (const c of cands) {
            try {
                c.tvl = parseFloat(ethers.utils.formatUnits(await qc.balanceOf(c.a), q.decimals)) * 2 * qUsd;
                if (!best || c.tvl > best.tvl) best = c;
            } catch (e) {}
        }
        if (best && best.tvl > 0) {
            try {
                let p;
                if (best.v3) {
                    const pc = new ethers.Contract(best.a, V3P_ABI, rp), [s, t0] = await Promise.all([pc.slot0(), pc.token0()]);
                    const r = (parseFloat(s[0].toString()) / 2 ** 96) ** 2, isT0 = L(t0) === L(t.address);
                    p = isT0 ? r * 10 ** (t.decimals - q.decimals) : 1 / (r * 10 ** (q.decimals - t.decimals));
                } else {
                    const pc = new ethers.Contract(best.a, PAIR_ABI, rp), [r, t0] = await Promise.all([pc.getReserves(), pc.token0()]);
                    const isT0 = L(t0) === L(t.address);
                    p = parseFloat(ethers.utils.formatUnits(isT0 ? r.r1 : r.r0, q.decimals)) / parseFloat(ethers.utils.formatUnits(isT0 ? r.r0 : r.r1, t.decimals));
                }
                usd = p * qUsd;
            } catch (e) {}
        }
        return poolCard(t, q, usd != null && isFinite(usd) && usd > 0 ? best : null, usd, lic);
    }

