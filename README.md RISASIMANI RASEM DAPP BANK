    async function binanceTickers(symbols) {
        const q = encodeURIComponent(JSON.stringify(symbols));
        for (const host of BINANCE_HOSTS) {
            for (const url of [`${host}/api/v3/ticker/24hr?symbols=${q}`, `${host}/api/v3/ticker/24hr`]) {
