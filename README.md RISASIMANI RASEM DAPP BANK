<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>RISASIMANI RASEM EMPIRE | MULTI-CHAIN TRUE DEX ENGINE</title>
    
    <!-- Ethers.js v5.7.2 Web3 Engine -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/ethers/5.7.2/ethers.umd.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;900&family=Orbitron:wght@400;600;800;900&display=swap');
        
        :root {
            --gold: #D4A017; 
            --neon-gold: #ffc83b; 
            --bg-dark: #050507;
            --panel-bg: rgba(12, 12, 15, 0.94); 
            --cyber-green: #00ff9d;
            --cyber-red: #ff3366; 
            --input-bg: #09090d;
            --side-panel-width: 280px;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body { 
            background: radial-gradient(circle at 50% 30%, #1a1205 0%, var(--bg-dark) 85%); 
            color: var(--gold); 
            font-family: 'Cinzel', serif;
            min-height: 100vh; 
            overflow-x: hidden;
        }

        body::before {
            content: ""; position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: linear-gradient(rgba(212, 160, 23, 0.03) 1px, transparent 1px),
                        linear-gradient(90deg, rgba(212, 160, 23, 0.03) 1px, transparent 1px);
            background-size: 32px 32px; pointer-events: none; z-index: 0;
        }

        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #050505; }
        ::-webkit-scrollbar-thumb { background: rgba(212, 160, 23, 0.4); border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--gold); }

        .yan-panel {
            position: fixed; top: 45px; left: 0; width: var(--side-panel-width);
            height: calc(100vh - 45px); background-color: rgba(6, 6, 8, 0.96);
            border-right: 1px solid rgba(212, 160, 23, 0.3); padding: 20px 15px;
            display: flex; flex-direction: column; gap: 16px; z-index: 90;
            overflow-y: auto; backdrop-filter: blur(12px);
        }

        .panel-resmi {
            width: 100%; height: auto; border-radius: 8px; border: 1px solid var(--gold);
            box-shadow: 0 0 10px rgba(212, 160, 23, 0.2); transition: transform 0.3s ease;
        }
        .panel-resmi:hover { transform: scale(1.02); }

        .rsm-market-widget {
            background: #000; border: 1px solid rgba(212, 160, 23, 0.35);
            border-radius: 8px; padding: 12px; font-family: 'Orbitron', sans-serif;
            box-shadow: inset 0 0 10px rgba(0,0,0,0.8);
        }
        .rsm-market-widget h4 {
            font-size: 0.78rem; color: #fff; margin-bottom: 8px; text-align: center;
            border-bottom: 1px dashed rgba(212, 160, 23, 0.3); padding-bottom: 5px; letter-spacing: 1px;
        }

        .top-bar {
            position: fixed; top: 0; left: 0; width: 100%; height: 45px;
            background: rgba(4, 4, 6, 0.98); border-bottom: 1px solid var(--gold);
            z-index: 999; display: flex; align-items: center; justify-content: space-between; overflow: hidden;
        }
        
        .live-clock {
            min-width: 180px; padding: 0 15px; font-family: 'Orbitron', sans-serif;
            color: var(--neon-gold); font-size: 0.78rem; font-weight: 700;
            border-right: 1px solid var(--gold); background: #000;
            display: flex; align-items: center; justify-content: center; height: 100%; z-index: 2;
        }

        .ticker-wrap { flex-grow: 1; height: 100%; display: flex; align-items: center; overflow: hidden; position: relative; }
        .ticker-row { display: flex; width: max-content; animation: marquee 35s linear infinite; will-change: transform; }
        .ticker-row:hover { animation-play-state: paused; }
        
        .ticker-item { 
            padding: 0 20px; font-size: 0.78rem; font-weight: 700; 
            font-family: 'Orbitron', sans-serif; display: flex; gap: 8px; 
            border-right: 1px solid rgba(212, 160, 23, 0.25); align-items: center; white-space: nowrap; 
        }
        .up { color: var(--cyber-green); text-shadow: 0 0 4px rgba(0,255,157,0.3); } 
        .down { color: var(--cyber-red); text-shadow: 0 0 4px rgba(255,51,102,0.3); } 
        .neutral { color: var(--neon-gold); }
        
        @keyframes marquee { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }

        .lang-container, .network-container {
            padding: 0 12px; display: flex; align-items: center; 
            border-left: 1px solid var(--gold); background: #000; height: 100%; z-index: 2;
        }
        
        .lang-select, .network-select {
            background: #000; color: var(--neon-gold); border: 1px solid rgba(212, 160, 23, 0.5);
            padding: 4px 10px; border-radius: 4px; font-family: 'Orbitron', sans-serif;
            font-size: 0.78rem; font-weight: bold; outline: none; cursor: pointer;
            transition: all 0.2s;
        }
        .network-select:hover, .lang-select:hover { border-color: var(--neon-gold); box-shadow: 0 0 8px rgba(212,160,23,0.4); }

        .layout-container {
            display: grid; grid-template-columns: 1fr 380px; gap: 24px;
            max-width: 1440px; margin: 65px 20px 40px calc(var(--side-panel-width) + 20px); 
            position: relative; z-index: 1;
        }

        .main-panel { 
            background: var(--panel-bg); border: 1px solid rgba(212, 160, 23, 0.4); 
            border-radius: 16px; padding: 28px; box-shadow: 0 10px 40px rgba(0,0,0,0.9); 
            position: relative; overflow: hidden; backdrop-filter: blur(12px);
        }

        h1 { font-size: 1.8rem; color: #fff; text-align: center; margin-bottom: 4px; text-shadow: 0 0 12px rgba(212,160,23,0.6); letter-spacing: 2px;}
        h2 { font-size: 0.85rem; color: var(--gold); text-align: center; margin-bottom: 22px; font-family: 'Orbitron'; letter-spacing: 3px; }
        
        #status { 
            text-align: center; padding: 10px; background: rgba(0,0,0,0.7); 
            border-radius: 8px; color: var(--cyber-green); font-family: 'Orbitron'; 
            margin-bottom: 20px; font-size: 0.82rem; border: 1px solid rgba(212, 160, 23, 0.3);
            letter-spacing: 1px; word-break: break-all; box-shadow: inset 0 0 10px rgba(0,0,0,0.8);
        }
        
        .main-connect-btn { 
            background: linear-gradient(135deg, #b8860b, #ffc83b); color: #000; 
            border: none; padding: 14px; border-radius: 8px; cursor: pointer; 
            font-weight: 800; font-family: 'Orbitron'; width: 100%; 
            transition: all 0.3s; letter-spacing: 1px; font-size: 0.95rem; margin-bottom: 22px;
            box-shadow: 0 4px 15px rgba(212, 160, 23, 0.3);
        }
        .main-connect-btn:hover { transform: translateY(-2px); box-shadow: 0 6px 25px rgba(212,160,23,0.6); }
        
        .tabs-container {
            display: flex; justify-content: center; gap: 8px; margin-bottom: 20px; flex-wrap: wrap;
        }
        .tab-btn {
            background: #0c0c10; border: 1px solid rgba(212, 160, 23, 0.4); color: var(--gold);
            padding: 10px 18px; border-radius: 6px; cursor: pointer;
            font-family: 'Orbitron'; font-weight: bold; font-size: 0.8rem;
            transition: all 0.3s ease; letter-spacing: 1px;
        }
        .tab-btn.active { background: var(--gold); color: #000; box-shadow: 0 0 12px rgba(212,160,23,0.5); }
        .tab-btn:hover:not(.active) { background: rgba(212, 160, 23, 0.2); border-color: var(--neon-gold); }

        .swap-container {
            background: rgba(6, 6, 10, 0.8); border: 1px solid rgba(212, 160, 23, 0.25);
            border-radius: 12px; padding: 22px; box-shadow: inset 0 0 20px rgba(0,0,0,0.8);
            display: none;
        }
        .swap-container.active { display: block; }

        .swap-box-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
        .swap-box-header h3 { color: #fff; font-family: 'Orbitron'; font-size: 0.95rem; letter-spacing: 1px; }

        .token-input-row {
            background: var(--input-bg); border: 1px solid #1f1f2e; border-radius: 10px;
            padding: 14px; margin-bottom: 10px; transition: border-color 0.3s;
        }
        .token-input-row:focus-within { border-color: var(--gold); box-shadow: 0 0 10px rgba(212,160,23,0.2); }

        .input-top { display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 0.75rem; color: #999; font-family: 'Orbitron'; }
        .input-bottom { display: flex; gap: 12px; align-items: center; }

        .input-bottom input {
            flex: 1; background: transparent; border: none; color: #fff;
            font-family: 'Orbitron'; font-size: 1.4rem; outline: none; width: 60%; font-weight: 700;
        }
        
        .token-select {
            background: #000; color: var(--neon-gold); border: 1px solid rgba(212, 160, 23, 0.4);
            padding: 8px 12px; border-radius: 6px; font-family: 'Orbitron';
            font-size: 0.88rem; font-weight: bold; outline: none; cursor: pointer;
            display: flex; align-items: center; gap: 6px; max-width: 170px;
        }

        .switch-btn-row { text-align: center; margin: -6px 0 6px 0; }
        .switch-btn {
            background: #111; border: 1px solid var(--gold); color: var(--gold);
            width: 36px; height: 36px; border-radius: 50%; cursor: pointer;
            font-size: 1.1rem; transition: all 0.3s; font-family: 'Orbitron'; display: inline-flex;
            align-items: center; justify-content: center; box-shadow: 0 0 10px rgba(0,0,0,0.8);
        }
        .switch-btn:hover { background: var(--gold); color: #000; transform: rotate(180deg); }

        .tag { 
            font-size: 0.68rem; padding: 4px 8px; border-radius: 4px; 
            background: rgba(0,255,157,0.1); color: var(--cyber-green); 
            border: 1px solid var(--cyber-green); font-family: 'Orbitron'; 
        }
        
        .info-row { display: flex; justify-content: space-between; margin-top: 12px; font-family: 'Orbitron'; font-size: 0.78rem; color: #aaa; }
        .highlight { color: var(--neon-gold); font-weight: bold; }
        
        .slippage-box { display: flex; justify-content: space-between; margin-top: 14px; font-family: 'Orbitron'; font-size: 0.78rem; align-items: center; }
        .slippage-opts { display: flex; gap: 6px; }
        .slip-btn { 
            background: #0c0c10; color: #888; border: 1px solid #222; 
            padding: 4px 10px; border-radius: 4px; cursor: pointer; 
            font-family: 'Orbitron'; font-size: 0.72rem; transition: 0.2s;
        }
        .slip-btn.active { background: rgba(212, 160, 23, 0.25); color: var(--gold); border-color: var(--gold); }

        .action-btn-group { display: flex; gap: 10px; margin-top: 18px; }
        .action-btn {
            flex: 1; padding: 14px; border-radius: 8px;
            font-family: 'Orbitron'; font-weight: 800; font-size: 0.92rem; border: none;
            cursor: pointer; transition: all 0.3s ease; letter-spacing: 1px;
            text-align: center;
        }
        .btn-action-swap { background: linear-gradient(135deg, #00b36c, var(--cyber-green)); color: #000; box-shadow: 0 4px 15px rgba(0,255,157,0.2); }
        .btn-action-approve { background: linear-gradient(135deg, #b8860b, var(--neon-gold)); color: #000; box-shadow: 0 4px 15px rgba(212,160,23,0.3); }
        .action-btn:disabled { opacity: 0.4; cursor: not-allowed; box-shadow: none; }
        .action-btn:hover:not(:disabled) { transform: translateY(-2px); opacity: 0.95; }

        .right-panel { display: flex; flex-direction: column; gap: 18px; }
        
        .market-container, .news-container { 
            background: #060608; border: 1px solid rgba(212, 160, 23, 0.3); 
            border-radius: 12px; padding: 16px; display: flex; flex-direction: column;
            backdrop-filter: blur(10px);
        }
        .market-container { height: 320px; }
        .news-container { flex-grow: 1; min-height: 250px; }
        
        .market-container h3, .news-container h3 { font-family: 'Orbitron'; font-size: 0.88rem; color: #fff; margin-bottom: 12px; text-align: center; letter-spacing: 1px; }
        
        .market-list, .news-list { display: flex; flex-direction: column; gap: 8px; overflow-y: auto; flex-grow: 1; padding-right: 4px; }
        .market-card { background: #0c0c10; border: 1px solid #1a1a24; border-radius: 6px; display: flex; justify-content: space-between; align-items: center; padding: 10px 12px; }
        
        .news-card { 
            background: #08080c; border-left: 3px solid var(--cyber-green); border-top: 1px solid #14141d;
            border-right: 1px solid #14141d; border-bottom: 1px solid #14141d;
            border-radius: 4px; padding: 10px; display: flex; flex-direction: column; gap: 4px;
            transition: all 0.2s;
        }
        .news-card:hover { border-left-color: var(--gold); background: #0d0d14; }
        .news-time { font-family: 'Orbitron'; font-size: 0.65rem; color: var(--neon-gold); }
        .news-title { font-size: 0.78rem; color: #eee; font-weight: bold; line-height: 1.3; font-family: 'Orbitron'; }
        
        .coin-symbol { font-family: 'Orbitron'; font-weight: 700; color: var(--gold); font-size: 0.85rem; }
        .coin-price { font-family: 'Orbitron'; font-weight: 700; color: #fff; font-size: 0.82rem; }

        #toast-container {
            position: fixed; bottom: 20px; right: 20px; z-index: 99999;
            display: flex; flex-direction: column; gap: 10px; max-width: 360px;
        }
        .toast {
            background: #0a0a0f; border: 1px solid var(--gold); color: #fff;
            padding: 12px 16px; border-radius: 8px; font-family: 'Orbitron'; font-size: 0.8rem;
            box-shadow: 0 5px 20px rgba(0,0,0,0.9); display: flex; align-items: center; justify-content: space-between;
            animation: slideIn 0.3s ease-out;
        }
        .toast-success { border-color: var(--cyber-green); color: var(--cyber-green); }
        .toast-error { border-color: var(--cyber-red); color: var(--cyber-red); }
        @keyframes slideIn { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }

        @media (max-width: 1100px) { 
            .yan-panel { position: relative; width: 100%; height: auto; top: 0; border-right: none; border-bottom: 1px solid var(--gold); }
            .layout-container { grid-template-columns: 1fr; margin-left: 20px; margin-top: 20px; } 
            .top-bar { flex-direction: column; height: auto; }
            .live-clock, .lang-container, .network-container { width: 100%; justify-content: center; }
        }
    
        .tick-ico { width: 18px; height: 18px; border-radius: 50%; vertical-align: middle; margin-right: 6px; }
        .news-card.hot { border-left-color: var(--gold); background: #0d0b04; }
        .news-card a { color: inherit; text-decoration: none; display: block; }
        .news-card a:hover .news-title { color: var(--gold); }
        .news-sec { font-family: 'Orbitron'; font-size: 0.68rem; letter-spacing: 1px; color: var(--gold); margin: 8px 0 2px; }
        .news-stamp { font-size: 0.62rem; color: #888; text-align: center; margin: -6px 0 8px; }
    </style>
</head>
<body>

<!-- ÜST CANLI FİYAT BANTLARI VE NETWORK SEÇİCİ -->
<div class="top-bar">
    <div class="live-clock" id="live-clock">00:00:00</div>
    <div class="ticker-wrap"><div class="ticker-row" id="global-ticker"><span style="color:#aaa; padding: 0 20px;">ON-CHAIN VERİLERİ BLOKZİNCİRDEN ÇEKİLİYOR...</span></div></div>
    
    <div class="network-container">
        <!-- BSC varsayılan: RSM, ASM ve 20 token burada -->
        <select id="network-selector" class="network-select" onchange="switchNetwork(this.value)">
            <option value="0x2105">Base Network</option>
            <option value="0x38" selected>BSC (BNB Smart Chain)</option>
        </select>
    </div>

    <div class="lang-container">
        <select id="lang-selector" class="lang-select" onchange="changeLanguage(this.value)">
            <option value="tr">TR 🇹🇷</option>
            <option value="en">EN 🇬🇧</option>
            <option value="de">DE 🇩🇪</option>
        </select>
    </div>
</div>

<!-- SOL SABİT YAN PANEL -->
<div class="yan-panel">
    <div style="text-align: center; margin-bottom: 10px;">
        <img class="panel-resmi" id="logo-rsm" alt="RSM Empire Logo">
    </div>

    <!-- RSM kutuları: aslanın (RSM logosu) altında -->
    <div id="side-rsm"><div class="rsm-market-widget" style="text-align:center;color:#aaa;font-size:0.75rem;">Havuzlar okunuyor...</div></div>

    <div style="text-align: center; margin-top: 10px;">
        <img class="panel-resmi" id="logo-asm" alt="Karakuzular ASM">
    </div>
    <!-- ASM kutuları: kuzunun (ASM logosu) altında -->
    <div id="side-asm"><div class="rsm-market-widget" style="text-align:center;color:#aaa;font-size:0.75rem;">Havuzlar okunuyor...</div></div>

    <!-- Diğer zincir-fiyatlı tokenlar (XGIRL vb.) -->
    <div id="side-market-panels"></div>
</div>

<!-- ANA İÇERİK DÜZENİ -->
<div class="layout-container">
    <div class="main-panel">
        <h1 id="ui-title">RISASIMANI RASEM EMPIRE</h1>
        <h2 id="ui-subtitle">TRUE DEX ROUTER & ON-CHAIN ENGINE</h2>
        
        <div id="status">OFFLINE • CÜZDAN BAĞLANTISI BEKLENİYOR...</div>
        <button class="main-connect-btn" onclick="connectWallet()" id="connect-btn">Cüzdanı Bağla (Web3 Connect)</button>

        <!-- TAKAS SEKMELERİ -->
        <div class="tabs-container">
            <button class="tab-btn active" onclick="switchTab('main', this)" id="tab-btn-main">ANA DEX</button>
            <button class="tab-btn" onclick="switchTab('btc', this)" id="tab-btn-btc">BTC TAKAS</button>
            <button class="tab-btn" onclick="switchTab('eth', this)" id="tab-btn-eth">ETH TAKAS</button>
        </div>

        <!-- 1. ANA TAKAS BÖLÜMÜ (Tüm Tokenler) -->
        <div class="swap-container active" id="tab-main">
            <div class="swap-box-header">
                <h3>🔄 ON-CHAIN ROUTER (ALL TOKENS)</h3>
                <span class="tag" id="main-router-tag">ROUTER</span>
            </div>
            
            <div class="token-input-row">
                <div class="input-top">
                    <span>Satılan (From)</span>
                    <span>Bakiye: <span class="highlight" id="main-from-bal">0.00</span></span>
                </div>
                <div class="input-bottom">
                    <input type="number" id="main-from-amount" placeholder="0.0" oninput="calculateQuote('main')">
                    <select class="token-select" id="main-from-token" onchange="onTokenChange('main')"></select>
                </div>
            </div>

            <div class="switch-btn-row">
                <button class="switch-btn" onclick="flipTokens('main')">↓</button>
            </div>

            <div class="token-input-row">
                <div class="input-top">
                    <span>Alınan (To - Tahmini)</span>
                    <span>Bakiye: <span class="highlight" id="main-to-bal">0.00</span></span>
                </div>
                <div class="input-bottom">
                    <input type="text" id="main-to-amount" placeholder="0.0" readonly>
                    <select class="token-select" id="main-to-token" onchange="onTokenChange('main')"></select>
                </div>
            </div>

            <!-- Slippage & Route Info -->
            <div class="slippage-box">
                <span>Kayma Toleransı (Slippage):</span>
                <div class="slippage-opts">
                    <button class="slip-btn" onclick="setSlippage(0.1, this)">0.1%</button>
                    <button class="slip-btn active" onclick="setSlippage(0.5, this)">0.5%</button>
                    <button class="slip-btn" onclick="setSlippage(1.0, this)">1.0%</button>
                </div>
            </div>

            <div class="info-row">
                <span>Tahmini Kur:</span>
                <span class="highlight" id="main-exchange-rate">1 Token = --</span>
            </div>
            <div class="info-row">
                <span>Yönlendirme Protokolü:</span>
                <span style="color:var(--cyber-green);" id="main-router-protocol">Blokzincir Üzerinden Otomatik Yönlendirme</span>
            </div>

            <div class="action-btn-group">
                <button class="action-btn btn-action-approve" id="main-approve-btn" onclick="executeApprove('main')" disabled>ONAYLA (APPROVE)</button>
                <button class="action-btn btn-action-swap" id="main-swap-btn" onclick="executeSwap('main')" disabled>TAKAS ET (SWAP)</button>
            </div>
        </div>

        <!-- 2. BTC DEDİKED TAKAS BÖLÜMÜ -->
        <div class="swap-container" id="tab-btc">
            <div class="swap-box-header">
                <h3 style="color:#f2a900;">🟠 BTC EXPRESS EXCHANGE</h3>
                <span class="tag">WRAPPED BTC ROUTER</span>
            </div>

            <div class="token-input-row">
                <div class="input-top">
                    <span>Ödenen Token</span>
                    <span>Bakiye: <span class="highlight" id="btc-from-bal">0.00</span></span>
                </div>
                <div class="input-bottom">
                    <input type="number" id="btc-from-amount" placeholder="0.0" oninput="calculateQuote('btc')">
                    <select class="token-select" id="btc-from-token" onchange="onTokenChange('btc')"></select>
                </div>
            </div>

            <div class="switch-btn-row">
                <button class="switch-btn" onclick="flipTokens('btc')">↓</button>
            </div>

            <div class="token-input-row">
                <div class="input-top">
                    <span>Alınan Bitcoin (BTC)</span>
                    <span>Bakiye: <span class="highlight" id="btc-to-bal">0.00</span></span>
                </div>
                <div class="input-bottom">
                    <input type="text" id="btc-to-amount" placeholder="0.0" readonly>
                    <select class="token-select" id="btc-to-token" onchange="onTokenChange('btc')"></select>
                </div>
            </div>

            <div class="info-row">
                <span>BTC Değişim Oranı:</span>
                <span class="highlight" id="btc-exchange-rate">Calculated on-chain</span>
            </div>

            <div class="action-btn-group">
                <button class="action-btn btn-action-approve" id="btc-approve-btn" onclick="executeApprove('btc')" disabled>BTC İÇİN ONAYLA</button>
                <button class="action-btn btn-action-swap" id="btc-swap-btn" onclick="executeSwap('btc')" disabled>BTC TAKAS ET</button>
            </div>
        </div>

        <!-- 3. ETH DEDİKED TAKAS BÖLÜMÜ -->
