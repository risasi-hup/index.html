    /* On-Chain Quote Calculation Engine (okuma RPC; son teklif saklanır, minimum çıktı ondan hesaplanır) */
    async function calculateQuote(tab) {
        const seq = ++quoteSeq;
        const amountIn = document.getElementById(`${tab}-from-amount`).value;
        const outInput = document.getElementById(`${tab}-to-amount`);
        const rateLabel = document.getElementById(`${tab}-exchange-rate`);
        const approveBtn = document.getElementById(`${tab}-approve-btn`);
        const swapBtn = document.getElementById(`${tab}-swap-btn`);
        const lock = msg => { outInput.value = msg || ""; delete lastQuote[tab]; if (approveBtn) approveBtn.disabled = true; if (swapBtn) swapBtn.disabled = true; };

        if (!amountIn || parseFloat(amountIn) <= 0) { lock(""); if (rateLabel) rateLabel.innerText = "1 Token = --"; return; }

        const net = NETWORKS[currentChainId];
        const fromSym = document.getElementById(`${tab}-from-token`).value;
        const toSym = document.getElementById(`${tab}-to-token`).value;
        const fromToken = net.tokens.find(t => t.symbol === fromSym);
        const toToken = net.tokens.find(t => t.symbol === toSym);
        if (!fromToken || !toToken || fromSym === toSym) { lock("Geçersiz Çift"); return; }
        const addrIn = fromToken.isNative ? net.wNative : fromToken.address;
        const addrOut = toToken.isNative ? net.wNative : toToken.address;
        if (addrIn.toLowerCase() === addrOut.toLowerCase()) { lock("Geçersiz Çift"); return; }
        if (pending(fromToken) || pending(toToken)) { lock("Token doğrulanıyor..."); return; }

        try {
            const rp = readRpc(currentChainId);
            const router = new ethers.Contract(net.routerAddress, ROUTER_ABI, rp);
            const parsedIn = ethers.utils.parseUnits(amountIn.toString(), fromToken.decimals);

            let path = [addrIn, addrOut], amounts;
            try { amounts = await router.getAmountsOut(parsedIn, path); }
            catch (directError) {
                // Otomatik yönlendirme: doğrudan havuz yoksa yerel sarmalı token (WBNB / WETH) üzerinden
                if (addrIn !== net.wNative && addrOut !== net.wNative) { path = [addrIn, net.wNative, addrOut]; amounts = await router.getAmountsOut(parsedIn, path); }
                else throw directError;
            }
            if (seq !== quoteSeq) return;   // daha yeni bir istek var, bu cevap eski

            const out = amounts[amounts.length - 1];
            const calculatedOut = ethers.utils.formatUnits(out, toToken.decimals);
            lastQuote[tab] = { out, path, from: fromSym, to: toSym, amt: amountIn };
            outInput.value = parseFloat(calculatedOut).toFixed(6);
            if (rateLabel) rateLabel.innerText = `1 ${fromSym} ≈ ${fmtPrice(parseFloat(calculatedOut) / parseFloat(amountIn))} ${toSym}` + (path.length > 2 ? " (via " + (net.nativeCurrency.symbol === "BNB" ? "WBNB" : "WETH") + ")" : "");

            if (userAddress && !fromToken.isNative) {
                const allowance = await new ethers.Contract(fromToken.address, ERC20_ABI, rp).allowance(userAddress, net.routerAddress);
                if (seq !== quoteSeq) return;
                if (allowance.gte(parsedIn)) { if (approveBtn) { approveBtn.disabled = true; approveBtn.innerText = "ONAYLANDI ✓"; } if (swapBtn) swapBtn.disabled = false; }
                else { if (approveBtn) { approveBtn.disabled = false; approveBtn.innerText = `${fromSym} ONAYLA`; } if (swapBtn) swapBtn.disabled = true; }
            } else {
                if (approveBtn) { approveBtn.disabled = true; approveBtn.innerText = "ONAY GEREKMİYOR"; }
                if (swapBtn) swapBtn.disabled = !userAddress;
            }
        } catch (e) {
            if (seq !== quoteSeq) return;
            console.error("Quote / Liquidity Error:", e);
            lock("Likidite Yetersiz");
            if (rateLabel) rateLabel.innerText = "Likidite Havuzu Bulunamadı";
        }
    }

    /* On-Chain ERC-20 Approve Engine — yalnızca bu takasın tutarı kadar izin (sınırsız izin yok) */
    async function executeApprove(tab) {
        if (!signer || !userAddress) { showToast("Lütfen önce cüzdanınızı bağlayın!", "error"); return; }
        const net = NETWORKS[currentChainId];
        const fromSym = document.getElementById(`${tab}-from-token`).value;
        const fromToken = net.tokens.find(t => t.symbol === fromSym);
        if (!fromToken || fromToken.isNative || pending(fromToken)) return;
        try {
            await ensureChain();
            const amt = ethers.utils.parseUnits(document.getElementById(`${tab}-from-amount`).value.toString(), fromToken.decimals);
            const erc20 = new ethers.Contract(fromToken.address, ERC20_ABI, signer);
            showToast(`${fromSym} için onay işlemi başlatılıyor...`, "info");
            const tx = await erc20.approve(net.routerAddress, amt);
            showToast(`İşlem Onayı Gönderildi! Tx: ${tx.hash.substring(0, 10)}...`, "info");
            await tx.wait();
            showToast(`${fromSym} Onaylandı! Takas edebilirsiniz.`, "success");
            calculateQuote(tab);
        } catch (err) { showToast("Onaylama Başarısız: " + (err.reason || err.message), "error"); }
    }

    /* On-Chain Real Swap Execution Engine — vergili/transfer ücretli tokenlar için SupportingFeeOnTransfer fonksiyonları */
    async function executeSwap(tab) {
        if (!signer || !userAddress) { showToast("Lütfen önce cüzdanınızı bağlayın!", "error"); return; }
        const amountInVal = document.getElementById(`${tab}-from-amount`).value;
        const net = NETWORKS[currentChainId];
        const fromSym = document.getElementById(`${tab}-from-token`).value;
        const toSym = document.getElementById(`${tab}-to-token`).value;
        const fromToken = net.tokens.find(t => t.symbol === fromSym);
        const toToken = net.tokens.find(t => t.symbol === toSym);
        const q = lastQuote[tab];
        if (!fromToken || !toToken || !q || q.from !== fromSym || q.to !== toSym || q.amt !== amountInVal) {
            showToast("Teklif yenileniyor — birkaç saniye sonra tekrar deneyin.", "error"); calculateQuote(tab); return;
        }
        try {
            await ensureChain();
            const router = new ethers.Contract(net.routerAddress, ROUTER_ABI, signer);
            const parsedIn = ethers.utils.parseUnits(amountInVal.toString(), fromToken.decimals);
            const amountOutMin = q.out.mul(1000 - Math.floor(slippagePercent * 10)).div(1000);   // tam (yuvarlanmamış) teklif üzerinden
            const deadline = Math.floor(Date.now() / 1000) + 60 * 20;
            showToast("Takas işlemi Cüzdanda Onay Bekliyor...", "info");
            let tx;
            if (fromToken.isNative) tx = await router.swapExactETHForTokensSupportingFeeOnTransferTokens(amountOutMin, q.path, userAddress, deadline, { value: parsedIn });
            else if (toToken.isNative) tx = await router.swapExactTokensForETHSupportingFeeOnTransferTokens(parsedIn, amountOutMin, q.path, userAddress, deadline);
            else tx = await router.swapExactTokensForTokensSupportingFeeOnTransferTokens(parsedIn, amountOutMin, q.path, userAddress, deadline);
            showToast(`Takas Gönderildi! Tx: ${tx.hash.substring(0, 12)}...`, "info");
            await tx.wait();
            showToast(`🎉 SWAP İŞLEMİ BAŞARIYLA TAMAMLANDI!`, "success");
            updateAllBalances(); calculateQuote(tab);
        } catch (err) {
            console.error("Swap Error:", err);
            showToast("Takas Hatası: " + (err.reason || err.message), "error");
        }
    }

